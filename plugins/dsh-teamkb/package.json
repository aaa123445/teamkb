{
  "name": "dsh-teamkb",
  "version": "0.1.6",
  "description": "TeamKB 团队知识库：分类检索、规范、知识链和经验证的知识贡献，支持 Harness Desktop 与 Web。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./docs/*.md": "./docs/*.md"
  },
  "files": [
    "index.js",
    "client.js",
    "network.js",
    "tools.js",
    "cordis.patch.yml",
    "README.md",
    "client-source.js",
    "build-client.cjs",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "workbench.js",
    "workbench-client.js",
    "ui-style.js",
    "workbench-client.jsx"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1 <0.2.3-0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node build-client.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aaa123445/teamkb.git",
    "directory": "plugins/dsh-teamkb"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "teamkb",
    "knowledge-base"
  ],
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "icon": "icon.svg"
}
